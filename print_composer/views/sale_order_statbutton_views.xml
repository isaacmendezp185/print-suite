
<odoo>
    <record id="view_sale_order_form_inherit_print_jobs_statbtn" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.print.jobs.statbtn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos el smart button en el header del pedido -->
            <xpath expr="//form/header" position="inside">
                <button name="action_view_print_jobs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print">
                    <field name="print_job_count" string="Trabajos" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

