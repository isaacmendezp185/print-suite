<odoo>
    <!-- Heredamos el formulario de pedido de venta -->
    <record id="view_order_form_inherit_print_composer" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.print.composer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertar botón en el árbol de order_line (tras la columna product_id) -->
            <xpath expr="//field[@name='order_line']//tree/field[@name='product_id']" position="after">
                <button name="action_open_print_composer"
                        string="Compositor"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>

