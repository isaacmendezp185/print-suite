
<odoo>
    <!-- Heredamos el formulario de pedido de venta -->
    <record id="view_order_form_inherit_print_composer" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.print.composer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertar el botón de la línea dentro de la vista LIST de order_line -->
            <xpath expr="//field[@name='order_line']//list" position="inside">
                <button name="action_open_print_composer"
                        string="Compositor"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>



