<odoo>
    <record id="view_print_finishing_apply_template_wizard" model="ir.ui.view">
        <field name="name">print.finishing.apply.template.wizard.form</field>
        <field name="model">print.finishing.apply.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar plantilla de acabados">
                <sheet>
                    <group>
                        <field name="job_id" readonly="1"/>
                        <field name="template_id" options="{'no_create': False}"/>
                    </group>
                    <group>
                        <field name="clear_existing"/>
                        <field name="estimate_after"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_finishing_apply_template" model="ir.actions.act_window">
        <field name="name">Aplicar plantilla</field>
        <field name="res_model">print.finishing.apply.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
