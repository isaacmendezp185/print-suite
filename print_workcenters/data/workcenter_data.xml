
<odoo noupdate="1">
    <!-- Usa calendario estándar de recursos -->
    <record id="wc_large_format" model="mrp.workcenter">
        <field name="name">Gran Formato</field>
        <field name="code">GF</field>
        <field name="print_center_type">large_format</field>
        <field name="capacity">1</field>
        <field name="time_efficiency">100.0</field>
        <field name="oee_target">85.0</field>
        <field name="resource_calendar_id" ref="resource.resource_calendar_std"/>
