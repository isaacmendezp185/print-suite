
<odoo>
    <!-- Menú raíz de la suite -->
    <menuitem id="menu_print_root"
              name="Impresión Gran Formato"
              sequence="20"
              groups="base.group_user"/>

    <!-- Submenú de configuración -->
    <menuitem id="menu_print_config_root"
              name="Configuración"
              parent="menu_print_root"
              sequence="10"
              groups="base.group_user"/>

    <!-- Vista lista: SOLO campos que existen en tu modelo -->
    <record id="view_print_mrp_workcenter_list" model="ir.ui.view">
        <field name="name">print.mrp.workcenter.list</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="print_center_type"/>
                <!-- Capacidad de producción (tu build usa capacity_uom) -->
                <field name="capacity_uom"/>
                <field name="time_efficiency"/>
                <field name="oee_target"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_print_mrp_workcenter_form" model="ir.ui.view">
        <field name="name">print.mrp.workcenter.form</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <form string="Centro de trabajo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="print_center_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="resource_calendar_id"/>
                            <field name="time_efficiency"/>
                            <field name="oee_target"/>
                            <!-- Costo por hora (en tu build es costs_hour) -->
                            <field name="costs_hour"/>
                        </group>
                    </group>

                    <group string="Parámetros de operación">
                        <group>
                            <!-- Tiempos antes/después de producir (presentes en tu modelo) -->
                            <field name="time_start"/>
                            <field name="time_stop"/>
                        </group>
                        <group>
                            <!-- Capacidad (campo que tienes disponible) -->
                            <field name="capacity_uom"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Descripción">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_print_workcenters" model="ir.actions.act_window">
        <field name="name">Centros de trabajo</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('print_center_type', '!=', False)]</field>
    </record>

    <!-- Enlaza menú -> acción -->
    action_print_workcenters
</odoo>
