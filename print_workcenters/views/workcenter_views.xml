
<odoo>
    <!-- Menú raíz de la suite -->
    <menuitem id="menu_print_root"
              name="Impresión Gran Formato"
              sequence="20"
              groups="base.group_user"/>

    <!-- Submenú de configuración -->
    <menuitem id="menu_print_config_root"
              name="Configuración"
              parent="menu_print_root"
              sequence="10"
              groups="base.group_user"/>

    <!-- Vistas específicas de Workcenter con campo de tipo -->
    <record id="view_print_mrp_workcenter_list" model="ir.ui.view">
        <field name="name">print.mrp.workcenter.list</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="print_center_type"/>
                <field name="capacity"/>
                <field name="time_efficiency"/>
                <field name="oee_target"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_print_mrp_workcenter_form" model="ir.ui.view">
        <field name="name">print.mrp.workcenter.form</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <form string="Centro de trabajo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="print_center_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="time_efficiency"/>
                            <field name="oee_target"/>
                            <field name="resource_calendar_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="note"/>
                        </page>
                        <page string="Mediciones">
                            <group>
                                <field name="time_start"/>
                                <field name="time_stop"/>
                                <field name="costs_hour"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción usando nuestras vistas y filtrando por centros con tipo asignado -->
    <record id="action_print_workcenters" model="ir.actions.act_window">
        <field name="name">Centros de trabajo</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_print_mrp_workcenter_list"/>
        <field name="context">{}</field>
        <field name="domain">[('print_center_type', '!=', False)]</field>
        <field name="help" type="html">
            <p>Puedes editar o ampliar los centros de trabajo de la imprenta aquí.</p>
        </field>
    </record>

    <!-- Menú de acceso a nuestros Workcenters -->
    <menuitem id="menu_print_workcenters"
              name="Centros de trabajo"
              parent="menu_print_config_root"
              action="action_print_workcenters"
              sequence="20"
              groups="base.group_user"/>
</odoo>
